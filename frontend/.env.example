# Base URL of the MetroMind Spring Boot backend.
#
# Local development: the Vite dev server (default http://localhost:5173) calls the
# backend on its default port, so this can stay as-is. Set it to the deployed
# backend (e.g. Render) for a production build — the compiled app then talks to
# that URL. No secrets belong here.
VITE_API_BASE_URL=http://localhost:8080